{
  "id": "direct_search_source_evidence",
  "description": "用户明确要求联网搜索、来源链接、官方规则或公告时，优先由 web/search 能力获取实时来源证据",
  "priority": 1300,
  "match": {
    "any_keywords": [
      "联网搜索",
      "来源链接",
      "来源清单",
      "官方来源",
      "官方公开规则",
      "公开规则",
      "官方规则",
      "官方公告",
      "规则原文",
      "只输出来源",
      "只给来源",
      "给出来源",
      "发布日期",
      "适用风险点",
      "搜索竞品",
      "竞品对比",
      "竞品定价",
      "竞品价格",
      "竞品售价",
      "竞对价格",
      "对标价格",
      "同类商品价格",
      "市场价格",
      "价格合规",
      "低价引流",
      "虚假宣传",
      "合规规则"
    ],
    "none_keywords": [
      "多智能体",
      "多岗位",
      "多角色",
      "协作",
      "协同",
      "分工",
      "虚拟员工"
    ],
    "allow_without_route": true
  },
  "nodes": [
    {
      "id": "search_evidence",
      "role": "search",
      "title": "实时来源搜索",
      "objective": "通过搜索 skill 获取用户要求的公开来源证据，并按用户要求输出来源标题、链接、发布日期和适用风险点：{{task}}。如果 search skill 返回 sources，最终回答只整理证据包，不扩写成运营方案；没有 sources 时才说明未拿到实时来源并给核验路径。",
      "llm_usage": "fast",
      "skill_autosuggest": true,
      "timeout_sec": 35,
      "max_attempts": 1,
      "acceptance": [
        "显式联网搜索或来源链接请求必须尝试 search skill。",
        "拿到实时 sources 时必须在最终回答里展示标题、链接、发布日期和风险点。",
        "不得把只要来源的请求扩写成运营方案。"
      ]
    }
  ]
}
