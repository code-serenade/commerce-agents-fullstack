{
  "id": "selected_route_roles",
  "description": "RoleRouter 高置信选中的多岗位路线，按 route primary/support roles 编排任务图",
  "priority": 1200,
  "match": {
    "route_score_min": 90,
    "route_min_non_chat_roles": 2,
    "none_keywords": [
      "老师点评",
      "课堂反馈",
      "课堂点评",
      "批改",
      "不要写成岗位报告",
      "不写成岗位报告",
      "不要岗位报告",
      "不是岗位报告",
      "岗位报告",
      "机械罗列岗位报告",
      "不要机械罗列岗位报告"
    ]
  },
  "dynamic_roles": {
    "from_route": {
      "enabled": true,
      "include_primary": true,
      "include_support": "when_requested_or_primary_data",
      "exclude_roles": ["chat"]
    }
  }
}
