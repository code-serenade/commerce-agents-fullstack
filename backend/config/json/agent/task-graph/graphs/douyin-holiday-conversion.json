{
  "id": "douyin_holiday_conversion",
  "description": "抖音、直播、节日、活动或千川投流的转化提升方案",
  "priority": 760,
  "match": {
    "any_keywords": [
      "抖音",
      "直播",
      "短视频",
      "五一",
      "节日",
      "营销",
      "活动",
      "促销",
      "投流",
      "千川",
      "引流"
    ],
    "all_keyword_groups": [
      ["转化率", "转化", "增长", "提升", "放量"],
      ["方案", "运营", "营销", "活动", "策略", "规划", "怎么做"]
    ],
    "none_keywords": ["只输出", "只回答", "一句话", "不要解释"],
    "allow_without_route": true
  },
  "nodes": [
    {
      "id": "data",
      "role": "data",
      "title": "数据诊断",
      "objective": "分析任务中的数据、指标、归因和约束：{{task}}"
    },
    {
      "id": "accounting",
      "role": "accounting",
      "title": "预算评估",
      "depends_on": ["data"],
      "objective": "基于上游数据诊断，评估活动成本、引流 SKU、投流预算和经营风险。"
    },
    {
      "id": "douyin_ads",
      "role": "douyin_ads",
      "title": "千川投放优化",
      "depends_on": ["data"],
      "objective": "基于上游数据诊断，拆解巨量千川计划结构、人群包、出价预算、ROI 止损线和直播/短视频承接。"
    },
    {
      "id": "creative",
      "role": "creative",
      "title": "创意产出",
      "depends_on": ["data"],
      "objective": "基于上游数据诊断，产出抖音短视频、直播或活动内容创意。"
    },
    {
      "id": "ops",
      "role": "ops",
      "title": "运营方案",
      "depends_on": ["accounting", "douyin_ads", "creative"],
      "objective": "整合财务、千川投放和创意结果，形成可执行运营方案。"
    }
  ]
}
