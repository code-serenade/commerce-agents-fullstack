  "rules": {
    "avg_daily_demand": {
      "default": 1.0,
      "result_min": 0.0
    },
    "lead_time_days": {
      "source_order": ["metric_alias", "explicit_period_days", "caller_default"],
      "round": true,
      "min": 1
    },
    "top_n": {
      "round": true,
      "min": 1,
      "max": 100
    },
    "sku_label_cleanup": {
      "trim_prefix_chars": ["-", "•", "*", " "],
      "prefer_last_sku_prefix": true,
      "sku_prefix_marker": "sku",
      "trim_delimiters": ["：", ":", ",", "，", ";", "；", " "]
    }
  },
  "parsers": {
    "inventory_skus": {
      "split_on": ["；", ";", "\n"],
      "required_text_alias_group": "inventory_sku_required_text",
      "required_fields": ["monthly_sales", "cost", "stock_qty"],
      "field_alias_groups": {
        "monthly_sales": "inventory_sku_monthly_sales",
        "cost": "inventory_sku_cost",
        "stock_qty": "inventory_sku_stock_qty"
      },
      "metric_match": "last_metric_value"
    },
    "abc_xyz_skus": {
      "split_on": ["；", ";", "\n"],
      "required_text_alias_group": "inventory_sku_required_text",
      "required_fields": ["gmv"],
      "gmv_alias_group": "abc_xyz_gmv",
      "history_alias_group": "abc_xyz_sales_history",
      "history_split_on": ["；", ";", "\n"],
      "metric_match": "last_metric_value"
    },
    "ad_fatigue_channels": {
      "segment_by_platform_labels": true,
      "dedupe_by_canonical_name": true,
      "emit_if_any_field_present": ["ctr_baseline", "ctr_recent", "impressions_per_user", "budget", "roas"]
