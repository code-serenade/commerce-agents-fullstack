{
  "rules": [
    {
      "id": "creative.video_script",
      "roles": [
        "creative"
      ],
      "match": {
        "any_keywords": [
          "视频",
          "短视频",
          "脚本",
          "分镜",
          "口播"
        ]
      },
      "skill_id": "creative_video_script",
      "input": {
        "product_name": "{{selected_product_name}}",
        "selling_points": "{{selected_product_features}}",
        "video_type": "{{video_type}}",
        "duration_seconds": "{{video_duration_seconds}}",
        "target_audience": "{{audience}}"
      },
      "reason": "autosuggest:creative.video_script"
    },
    {
      "id": "creative.seeding_copy",
      "roles": [
        "creative"
      ],
      "match": {
        "any_keywords": [
          "种草",
          "小红书",
          "笔记",
          "内容文案"
        ]
      },
      "skill_id": "creative_seeding_copy",
      "input": {
        "product_name": "{{selected_product_name}}",
        "brand_name": "{{selected_product_brand_name}}",
        "selling_points": "{{selected_product_features}}",
        "platform": "{{selected_product_article_platform}}",
        "target_audience": "{{audience}}"
      },
      "reason": "autosuggest:creative.seeding_copy"
    },
    {
      "id": "creative.title_ctr",
      "roles": [
        "creative"
      ],
      "match": {
        "any_keywords": [
          "标题",
          "点击率",
          "CTR",
          "ctr",
          "高点击"
        ]
      },
      "skill_id": "creative_title_ctr_scorer",
      "input": {
        "title": "{{title_candidate}}",
        "target_keywords": "{{keyword_candidates}}"
      },
      "reason": "autosuggest:creative.title_ctr"
    }
  ]
}
