        "questions": [
          "{{task_description}}"
        ]
      },
      "reason": "autosuggest:service.faq_playbook"
    },
    {
      "id": "service.query_product",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "查询商品",
          "查商品",
          "商品信息",
          "商品资料",
          "商品上下文",
          "商品详情",
          "商品知识",
          "引用商品",
          "选中商品"
        ]
      },
      "skill_id": "service_query_product",
