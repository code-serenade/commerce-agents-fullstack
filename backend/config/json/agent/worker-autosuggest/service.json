{
  "rules": [
    {
      "id": "service.ticket_handler",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "ticket",
          "工单",
          "话术",
          "客服话术",
          "客户投诉",
          "物流延迟",
          "发错",
          "质量问题"
        ],
        "none_keywords": [
          "一句话",
          "一句客服话术",
          "一句话术",
          "回一句",
          "自然一点",
          "不要像公告",
          "不要完整 SOP",
          "不要SOP",
          "别展开"
        ]
      },
      "skill_id": "service_ticket_handler",
      "input": {
        "issue_type": "售后咨询",
        "customer_message": "{{task_description}}",
        "customer_emotion": "普通"
      },
      "reason": "autosuggest:service.ticket_handler"
    },
    {
      "id": "service.escalation_flow",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "upgrade",
          "escalation",
          "升级",
          "主管",
          "投诉平台",
          "平台介入",
          "曝光",
          "举报",
          "维权",
          "威胁投诉"
        ]
      },
      "skill_id": "service_escalation_flow",
      "input": {
        "issue_description": "{{task_description}}",
        "customer_emotion": "威胁投诉"
      },
      "reason": "autosuggest:service.escalation_flow"
    },
    {
      "id": "service.return_handler",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "return",
          "refund",
          "退款",
          "退货",
          "换货",
          "售后"
        ],
        "none_keywords": [
          "一句话",
          "一句客服话术",
          "一句话术",
          "回一句",
          "自然一点",
          "不要像公告",
          "不要完整 SOP",
          "不要SOP",
          "别展开"
        ]
      },
      "skill_id": "service_return_handler",
      "input": {
        "reason": "售后咨询"
      },
      "reason": "autosuggest:service.return_handler"
    },
    {
      "id": "service.faq_playbook",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "faq",
          "FAQ",
          "常见问题",
          "问答库",
          "标准话术",
          "话术库"
        ]
      },
      "skill_id": "service_faq_playbook",
      "input": {
        "questions": [
          "{{task_description}}"
        ]
      },
      "reason": "autosuggest:service.faq_playbook"
    },
    {
      "id": "service.query_product",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "查询商品",
          "查商品",
          "商品信息",
          "商品资料",
          "商品上下文",
          "商品详情",
          "商品知识",
          "引用商品",
          "选中商品"
        ]
      },
      "skill_id": "service_query_product",
      "input": {
        "product_name": "{{task_description}}"
      },
      "reason": "autosuggest:service.query_product"
    },
    {
      "id": "service.sentiment",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "情绪",
          "情感",
          "差评",
          "不满意",
          "愤怒",
          "投诉"
        ]
      },
      "skill_id": "service_sentiment_analyzer",
      "input": {
        "customer_text": "{{task_description}}"
      },
      "reason": "autosuggest:service.sentiment"
    },
    {
      "id": "service.nps",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "nps",
          "NPS",
          "推荐值",
          "客户忠诚"
        ]
      },
      "skill_id": "service_nps_analyzer",
      "input": {},
      "reason": "autosuggest:service.nps"
    },
    {
      "id": "service.dsr",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "dsr",
          "DSR",
          "服务评分",
          "店铺评分",
          "评分低"
        ]
      },
      "skill_id": "service_dsr_improvement",
      "input": {},
      "reason": "autosuggest:service.dsr"
    },
    {
      "id": "service.nps_driver",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "driver",
          "驱动因素",
          "满意度原因",
          "投诉分类",
          "nps驱动",
          "nps driver"
        ]
      },
      "skill_id": "service_nps_driver_analysis",
      "input": {
        "platform": "{{platform}}",
        "product_ref": "{{selected_product_ref}}"
      },
      "reason": "autosuggest:service.nps_driver"
    },
    {
      "id": "service.benchmark_search",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "行业基准",
          "行业均值",
          "行业平均",
          "实时基准",
          "最新基准",
          "benchmark",
          "ROI基准",
          "roi基准",
          "ROAS基准",
          "转化率基准"
        ],
        "requires_any_skill_ids": [
          "service_dsr_improvement",
          "service_nps_analyzer",
          "service_nps_driver_analysis"
        ]
      },
      "skill_id": "search_industry_benchmarks",
      "input": {
        "industry": "{{search_industry}}",
        "metric": "{{search_benchmark_metric}}",
        "platform": "{{search_platform}}",
        "days": 30,
        "_needs_fresh_data": true,
        "product_ref": "{{selected_product_ref}}",
        "product_name": "{{selected_product_name}}",
        "product_category": "{{category}}"
      },
      "reason": "autosuggest:service.benchmark_search"
    },
    {
      "id": "service.platform_policy_search",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "平台规则",
          "平台政策",
          "平台公告",
          "最新规则",
          "最新政策",
          "规则变化",
          "审核规则",
          "违禁词",
          "佣金",
          "费率",
          "policy"
        ],
        "requires_any_skill_ids": [
          "service_ticket_handler",
          "service_faq_playbook",
          "service_escalation_flow",
          "service_return_handler"
        ]
      },
      "skill_id": "search_platform_policy",
      "input": {
        "platform": "{{search_platform}}",
        "policy_type": "general",
        "days": 30,
        "_needs_fresh_data": true,
        "product_ref": "{{selected_product_ref}}",
        "product_name": "{{selected_product_name}}",
        "product_category": "{{category}}"
      },
      "reason": "autosuggest:service.platform_policy_search"
    },
    {
      "id": "service.review_search",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "评价",
          "口碑",
          "差评",
          "好评",
          "用户反馈",
          "买家反馈",
          "真实反馈",
          "痛点",
          "顾虑",
          "review",
          "reviews"
        ],
        "requires_any_skill_ids": [
          "service_sentiment_analyzer",
          "service_ticket_handler",
          "service_return_handler",
          "service_nps_driver_analysis"
        ]
      },
      "skill_id": "search_product_reviews",
      "input": {
        "query": "{{search_query}}",
        "platform": "{{search_platform}}",
        "focus": "{{search_review_focus}}",
        "days": 30,
        "_needs_fresh_data": true,
        "product_ref": "{{selected_product_ref}}",
        "product_name": "{{selected_product_name}}",
        "product_category": "{{category}}"
      },
      "reason": "autosuggest:service.review_search"
    },
    {
      "id": "service.fallback_dsr",
      "roles": [
        "service"
      ],
      "fallback": true,
      "match": {
        "none_keywords": [
          "一句话",
          "一句客服话术",
          "一句话术",
          "回一句",
          "自然一点",
          "不要像公告",
          "不要完整 SOP",
          "不要SOP",
          "别展开"
        ]
      },
      "skill_id": "service_dsr_improvement",
      "input": {
        "platform": "{{platform}}"
      },
      "reason": "autosuggest:service.fallback_dsr"
    }
  ]
}
