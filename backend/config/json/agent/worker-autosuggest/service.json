{
  "rules": [
    {
      "id": "service.ticket_handler",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "ticket",
          "工单",
          "话术",
          "客服话术",
          "客户投诉",
          "物流延迟",
          "发错",
          "质量问题"
        ]
      },
      "skill_id": "service_ticket_handler",
      "input": {
        "issue_type": "售后咨询",
        "customer_message": "{{task_description}}",
        "customer_emotion": "普通"
      },
      "reason": "autosuggest:service.ticket_handler"
    },
    {
      "id": "service.escalation_flow",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "upgrade",
          "escalation",
          "升级",
          "主管",
          "投诉平台",
          "平台介入",
          "曝光",
          "举报",
          "维权",
          "威胁投诉"
        ]
      },
      "skill_id": "service_escalation_flow",
      "input": {
        "issue_description": "{{task_description}}",
        "customer_emotion": "威胁投诉"
      },
      "reason": "autosuggest:service.escalation_flow"
    },
    {
      "id": "service.return_handler",
      "roles": [
        "service"
      ],
      "match": {
        "any_keywords": [
          "return",
          "refund",
          "退款",
          "退货",
          "换货",
          "售后"
        ]
      },
      "skill_id": "service_return_handler",
      "input": {
        "reason": "售后咨询"
      },
      "reason": "autosuggest:service.return_handler"
    },
    {
      "id": "service.faq_playbook",
      "roles": [
        "service"
      ],
