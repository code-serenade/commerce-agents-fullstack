      "id": "finance.revenue_profit.choice.001",
      "version": 1,
      "status": "approved",
      "domainCode": "finance",
      "questionType": "single_choice",
      "prompt": "本月销售收入增长了，下面哪项结论最准确？",
      "choices": [
        { "id": "check_costs", "text": "还不能判断利润增长，需要同时比较商品成本、投放、履约和售后等费用" },
        { "id": "profit_certain", "text": "利润一定同比增长，因为销售收入就是利润" },
        { "id": "costs_irrelevant", "text": "只要收入增长，成本和费用的变化就不再重要" },
        { "id": "cash_equals_profit", "text": "收到的现金增加多少，利润就必然增加多少" }
      ],
      "correctChoiceId": "check_costs",
      "referenceAnswer": "收入与利润不是同一指标。判断利润是否增长，还要比较商品成本、投放、履约、售后等相关成本和费用的变化。",
      "rubric": {
        "version": 1,
