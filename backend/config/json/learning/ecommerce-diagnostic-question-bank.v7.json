    {
      "id": "market.trends_region_relative.choice.006",
      "version": 1,
      "status": "approved",
      "domainCode": "market",
      "questionType": "single_choice",
      "prompt": "同一关键词在 Google Trends 的地区比较中，A 地区为 80，B 地区为 40。哪种解释更稳妥？",
      "choices": [
        { "id": "double_absolute_searches", "text": "A 地区的绝对搜索次数一定是 B 地区的两倍" },
        { "id": "double_sales", "text": "A 地区的商品销量一定是 B 地区的两倍" },
        { "id": "relative_share_higher", "text": "A 地区在各自搜索总量中的相对兴趣更高，但不能据此推算绝对搜索量或销量" },
        { "id": "same_population", "text": "两个地区的人口规模一定相同" }
      ],
      "correctChoiceId": "relative_share_higher",
      "referenceAnswer": "Trends 的地区值按该地区全部搜索中的相对占比归一化。80 与 40 表示相对兴趣不同，不能直接推出绝对搜索次数、人口或销量倍数。",
      "rubric": {
