    {
      "id": "market.trends_not_sales.choice.005",
      "version": 1,
      "status": "approved",
      "domainCode": "market",
      "questionType": "single_choice",
      "prompt": "某商品关键词在 Google Trends 中的相对热度连续上涨。下面哪项判断最准确？",
      "choices": [
        { "id": "sales_same_rate", "text": "可以直接断定该商品销量会按相同比例上涨" },
        { "id": "profit_confirmed", "text": "可以直接断定该商品利润已经上涨" },
        { "id": "relative_interest_signal", "text": "这说明相对搜索兴趣在上升，但仍应结合实际流量、转化和销售数据验证需求" },
        { "id": "absolute_buyers", "text": "热度数值就是实际购买人数" }
      ],
      "correctChoiceId": "relative_interest_signal",
      "referenceAnswer": "Google Trends 展示的是经过归一化的相对搜索兴趣，不是销量、利润或实际购买人数。它可以作为市场关注信号，但需要结合站内流量、转化和销售数据验证。",
      "rubric": {
        "version": 1,
        "criteria": [
          {
            "code": "distinguish_search_interest_from_sales",
            "weight": 1.0,
            "concepts": ["相对搜索兴趣不是销量", "结合实际经营数据验证"]
          }
        ],
        "contradictions": [],
        "partialThreshold": 0.5,
        "correctThreshold": 1.0
      },
      "sources": [
        {
