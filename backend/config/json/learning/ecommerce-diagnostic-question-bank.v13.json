    {
      "id": "product.highlight_test_conditions.choice.019",
      "version": 1,
      "status": "approved",
      "domainCode": "product",
      "questionType": "single_choice",
      "prompt": "写杯子的卖点时，现有测试仅记录“室内25℃、起始水温95℃，6小时后水温60℃”。哪种表达保留了证据边界？",
      "choices": [
        {
          "id": "a",
          "text": "任何环境下都能永久保温"
        },
        {
          "id": "b",
          "text": "说明测试条件与6小时后测得60℃，不推断所有环境的效果"
        },
        {
          "id": "c",
          "text": "保证所有用户24小时后仍是95℃"
        },
        {
          "id": "d",
          "text": "不提条件，只说绝对最强"
        }
      ],
      "correctChoiceId": "b",
      "referenceAnswer": "证据只覆盖题干列出的环境、初始水温和测量时间，可靠表达应把这些条件和结果一起说明。它不能推出任何环境下永久保温，也不能保证所有人24小时后仍为95℃。Google 指南建议实际测试内容说明测试方式和结果并提供证明。本题强调证据适用边界，不代表这一测试已满足某个平台或产品认证要求。换一个环境或使用方式，需要对应的新证据。",
      "rubric": {
        "version": 1,
        "criteria": [
          {
            "code": "highlight_test_conditions",
            "weight": 1,
            "concepts": [
              "卖点保留测试条件与结果",
              "不从局部测试推出无限保证"
            ]
          }
        ],
