    {
      "id": "product.title_claim_evidence.choice.018",
      "version": 1,
      "status": "approved",
      "domainCode": "product",
      "questionType": "single_choice",
      "prompt": "商家要在标题中新增“可承重20kg”，但现有资料没有承重数据。仅从标题事实可靠性看，应先做什么？",
      "choices": [
        {
          "id": "a",
          "text": "直接加入数字，显得专业"
        },
        {
          "id": "b",
          "text": "先核对适用该款商品的测试或资料，无依据就不写为确定性能"
        },
        {
          "id": "c",
          "text": "从别的型号复制同一数字"
        },
        {
          "id": "d",
          "text": "把20kg改成30kg，突出优势"
        }
      ],
      "correctChoiceId": "b",
      "referenceAnswer": "性能数字必须有与当前商品对应的事实依据。正确动作是先核对该型号的测试方法、条件和结果；资料不足时不要把未证实的数字写成确定性能。增加数字或复制另一型号并不能补足证据。官方指南要求内容可靠、避免容易验证的事实错误，并说明第一手经验的依据。即使取得测试结果，也不能忽略适用条件；这道题不评价具体安全标准是否已经达标。",
      "rubric": {
        "version": 1,
        "criteria": [
          {
            "code": "title_claim_evidence",
            "weight": 1,
            "concepts": [
              "性能主张先核验对应证据",
              "不同型号的证据不能自动通用"
            ]
          }
        ],
