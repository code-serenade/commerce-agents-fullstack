      "version": 1,
      "status": "approved",
      "domainCode": "product",
      "questionType": "single_choice",
      "prompt": "优化一款咖啡商品的标题时，下面哪种做法最稳妥？",
      "choices": [
        {
          "id": "add_price_shipping_promotion",
          "text": "把限时价格、包邮和促销日期都塞进标题，尽量制造紧迫感"
        },
        {
          "id": "describe_product_and_variant_clearly",
          "text": "切中要点地描述落地页上的同一商品，并写清口味、规格等可区分信息"
        },
        {
          "id": "use_symbols_and_all_caps",
          "text": "大量使用符号和全大写文字，让标题在列表中更醒目"
        },
        {
          "id": "reuse_one_generic_title",
          "text": "所有咖啡规格都使用同一个宽泛标题，不体现口味或净含量差异"
        }
      ],
      "correctChoiceId": "describe_product_and_variant_clearly",
      "referenceAnswer": "Google Merchant Center 商品名规范要求用切中要点的商品名清楚描述落地页上的同一商品，并在商品名中加入款式或规格特有的细节；同时不应加入价格、促销日期、运费等促销文字。因此，准确描述商品并区分口味、规格等变体信息最稳妥。",
      "rubric": {
        "version": 1,
        "criteria": [
          {
            "code": "title_matches_product_and_distinguishes_variant",
            "weight": 1.0,
            "concepts": [
