      "id": "product.highlight_focus.choice.012",
      "version": 1,
      "status": "approved",
      "domainCode": "product",
      "questionType": "single_choice",
      "prompt": "为一款咖啡提炼商品卖点时，下面哪组表达原则更合适？",
      "choices": [
        {
          "id": "compare_and_claim_best",
          "text": "重点写“全面碾压其他品牌”和“全网最好”，不必说明商品本身"
        },
        {
          "id": "describe_store_history_and_policy",
          "text": "主要介绍店铺发展历史、退换政策和其他在售商品"
        },
        {
          "id": "focus_on_product_with_professional_language",
          "text": "只介绍咖啡本身的具体亮点，用专业、符合语法的表达，不混入促销或竞品比较"
        },
        {
          "id": "repeat_keywords_and_links",
          "text": "重复堆砌热门关键词，并加入店铺链接和促销口号"
        }
      ],
      "correctChoiceId": "focus_on_product_with_professional_language",
      "referenceAnswer": "Google Merchant Center 商品亮点规范要求卖点只介绍商品本身，不介绍店铺历史、政策或其他商品；应使用专业且符合语法的语言，避免促销文字、关键词堆砌和与其他商品比较。因此，围绕咖啡本身的可核实亮点进行清晰表达更合适。",
