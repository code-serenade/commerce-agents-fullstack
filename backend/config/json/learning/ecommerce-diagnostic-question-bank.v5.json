    {
      "id": "market.trends_relative_index.choice.001", "version": 1, "status": "approved", "domainCode": "market", "questionType": "single_choice",
      "prompt": "Google Trends 中某关键词在所选地区和时段的热度为 100，最准确的理解是什么？",
      "choices": [{"id":"one_hundred_searches","text":"它表示该关键词恰好被搜索了100次"},{"id":"full_market_share","text":"它表示该关键词占全部市场需求的100%"},{"id":"one_hundred_buyers","text":"它表示已有100名用户完成购买"},{"id":"peak_relative","text":"它是该查询在所选地区和时段内的相对热度峰值，不代表恰好有100次搜索"}],
      "correctChoiceId": "peak_relative", "referenceAnswer": "Google Trends 将所选地区和时段内的数据归一化并按 0 到 100 缩放；100 表示相对热度峰值，不是绝对搜索次数或成交人数。",
      "rubric": {"version":1,"criteria":[{"code":"interpret_relative_peak","weight":1.0,"concepts":["相对热度峰值","不是绝对搜索次数"]}],"contradictions":[],"partialThreshold":0.5,"correctThreshold":1.0},
      "sources": [{"sourceId":"google.trends.faq.data","authorityLevel":"primary_official","publisher":"Google","title":"FAQ about Google Trends data","url":"https://support.google.com/trends/answer/4365533?hl=en","publishedVersion":"Google Trends Help","checkedAt":"2026-08-27","validThrough":"2027-08-27","licenseType":"official_reference_only","useMode":"source_based_original","licenseUrl":"https://policies.google.com/terms"}],
      "review": {"authorId":"source_backed_choice_seed_20260827","reviewerId":"question_bank_gate_v2","reviewScope":"source_and_rubric_engineering_review","reviewerType":"automated_engineering_gate","curriculumReviewRequired":true,"reviewedAt":"2026-08-27","decision":"approved_for_internal_pilot"}
    },
    {
      "id": "market.trends_compare_context.choice.002", "version": 1, "status": "approved", "domainCode": "market", "questionType": "single_choice",
      "prompt": "用 Google Trends 比较两个商品关键词时，哪种做法最能减少误判？",
      "choices": [{"id":"compare_screenshots","text":"分别截取不同地区、不同时间范围的图后直接比较数值"},{"id":"same_context","text":"在相同地区、时间范围和分类条件下比较，并结合其他数据验证"},{"id":"treat_as_sales","text":"把 Trends 指数直接当作商品销量"},{"id":"ignore_low_volume","text":"只要指数较低就认定市场需求为零"}],
      "correctChoiceId": "same_context", "referenceAnswer": "Trends 数值依赖所选地区、时间和类别并经过归一化；应在一致条件下比较，且不能把搜索兴趣直接等同于销量。",
      "rubric": {"version":1,"criteria":[{"code":"compare_under_same_context","weight":1.0,"concepts":["相同地区时间分类","结合其他数据验证"]}],"contradictions":[],"partialThreshold":0.5,"correctThreshold":1.0},
      "sources": [{"sourceId":"google.trends.faq.data","authorityLevel":"primary_official","publisher":"Google","title":"FAQ about Google Trends data","url":"https://support.google.com/trends/answer/4365533?hl=en","publishedVersion":"Google Trends Help","checkedAt":"2026-08-27","validThrough":"2027-08-27","licenseType":"official_reference_only","useMode":"source_based_original","licenseUrl":"https://policies.google.com/terms"}],
      "review": {"authorId":"source_backed_choice_seed_20260827","reviewerId":"question_bank_gate_v2","reviewScope":"source_and_rubric_engineering_review","reviewerType":"automated_engineering_gate","curriculumReviewRequired":true,"reviewedAt":"2026-08-27","decision":"approved_for_internal_pilot"}
    },
    {
      "id": "market.trends_zero_value.choice.003", "version": 1, "status": "approved", "domainCode": "market", "questionType": "single_choice",
      "prompt": "Google Trends 图表中某个时点显示为 0，应该怎样解释？",
      "choices": [{"id":"zero_sales","text":"该时点商品销量一定为零"},{"id":"no_people","text":"该地区一定没有任何人搜索过"},{"id":"insufficient_relative_data","text":"相对于当前比较范围，该点没有足够数据或数值过低，不能直接断言绝对搜索量为零"},{"id":"tracking_broken","text":"一定是网站埋点故障"}],
      "correctChoiceId": "insufficient_relative_data", "referenceAnswer": "Trends 的 0 表示在当前归一化尺度下数据不足或相对值过低，并不等价于绝对搜索次数或销量必然为零。",
      "rubric": {"version":1,"criteria":[{"code":"interpret_zero_conservatively","weight":1.0,"concepts":["数据不足或相对值过低","不能断言绝对量为零"]}],"contradictions":[],"partialThreshold":0.5,"correctThreshold":1.0},
      "sources": [{"sourceId":"google.trends.faq.data","authorityLevel":"primary_official","publisher":"Google","title":"FAQ about Google Trends data","url":"https://support.google.com/trends/answer/4365533?hl=en","publishedVersion":"Google Trends Help","checkedAt":"2026-08-27","validThrough":"2027-08-27","licenseType":"official_reference_only","useMode":"source_based_original","licenseUrl":"https://policies.google.com/terms"}],
