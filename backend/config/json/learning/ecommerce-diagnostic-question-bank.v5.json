      "rubric": {"version":1,"criteria":[{"code":"preserve_gtin_integrity","weight":1.0,"concepts":["不虚构GTIN","按实际标识提交"]}],"contradictions":[],"partialThreshold":0.5,"correctThreshold":1.0},
      "sources": [{"sourceId":"google.merchant.product_spec.gtin","authorityLevel":"primary_official","publisher":"Google","title":"Product data specification: GTIN","url":"https://support.google.com/merchants/answer/6324461?hl=en","publishedVersion":"Merchant Center Help","checkedAt":"2026-08-27","validThrough":"2027-02-27","licenseType":"official_reference_only","useMode":"source_based_original","licenseUrl":"https://policies.google.com/terms"}],
