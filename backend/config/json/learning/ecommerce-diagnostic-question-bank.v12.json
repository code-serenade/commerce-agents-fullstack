      "domainCode": "product",
      "questionType": "single_choice",
      "prompt": "为一款有明确规格或变体的商品写标题时，哪组信息最值得保留在标题中？",
      "choices": [
        { "id": "category_pack_and_variant", "text": "商品品类、真实规格，以及能区分商品的颜色、尺寸、口味或形态信息" },
        { "id": "store_history", "text": "店铺成立年份、客服在线时间和退换货承诺" },
        { "id": "promotion_only", "text": "只写限时折扣、包邮和活动截止日期" },
        { "id": "symbols_only", "text": "只用符号和重复关键词吸引注意，不说明商品是什么" }
      ],
      "correctChoiceId": "category_pack_and_variant",
      "referenceAnswer": "Google Merchant Center 商品名规范要求用切中要点的商品名准确描述落地页上的商品，并用颜色、尺寸等变体特有细节区分不同款式；同时不得在商品名中加入价格、促销日期或运费等促销文字。因此，商品品类、真实规格及颜色、尺寸、口味或形态等可区分信息，比店铺介绍或促销口号更适合进入标题。",
      "rubric": {
        "version": 1,
        "criteria": [{
          "code": "title_prioritizes_product_pack_and_variant_details",
          "weight": 1.0,
          "concepts": ["标题优先说明商品品类和真实规格", "使用颜色尺寸口味形态等真实变体信息区分商品"]
        }],
