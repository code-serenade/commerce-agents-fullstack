    {
      "id": "product.highlight_verifiable.choice.015",
      "version": 1,
      "status": "approved",
      "domainCode": "product",
      "questionType": "single_choice",
      "prompt": "为本轮商品补充卖点时，哪种写法更可靠？",
      "choices": [
        { "id": "verifiable_product_fact", "text": "围绕商品本身写可核实的规格、形态或使用场景，并保持表达专业清楚" },
        { "id": "absolute_superiority", "text": "写成“全网最好、效果碾压所有品牌”，无需提供依据" },
        { "id": "keyword_repetition", "text": "反复堆砌“提神、爆款、必买”等词，越多越好" },
        { "id": "store_policy", "text": "用店铺历史、退换政策和其他商品介绍代替本商品卖点" }
      ],
      "correctChoiceId": "verifiable_product_fact",
      "referenceAnswer": "Google Merchant Center 商品亮点规范要求只描述商品本身，使用专业且符合语法的语言，并避免促销文字、关键词堆砌和与其他商品比较。因而应围绕本轮商品可核实的规格、形态或真实使用信息清楚表达；没有依据的绝对化比较、重复关键词和店铺政策都不能可靠地说明商品卖点。",
