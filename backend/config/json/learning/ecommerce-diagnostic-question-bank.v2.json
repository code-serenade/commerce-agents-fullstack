      "domainCode": "traffic",
      "questionType": "scenario_decision",
      "prompt": "点击量上涨但成交没有变化时，你会怎样用电商漏斗先定位问题？",
      "referenceAnswer": "先统一统计口径，再比较浏览商品、加购、开始结账和购买各环节的转化率，找到下降最明显的环节后再判断是流量承接、结账还是支付问题。",
      "rubric": {
        "version": 1,
        "criteria": [
          {
            "code": "compare_funnel_stages",
            "weight": 0.6,
            "concepts": ["漏斗", "浏览到加购", "加购到结账", "结账到购买", "各环节转化"]
          },
          {
            "code": "locate_dropoff_before_action",
            "weight": 0.4,
            "concepts": ["定位流失环节", "先找下降环节", "比较各阶段", "确认掉在哪一步"]
          }
        ],
        "contradictions": [
