      "id": "finance.revenue_profit.001",
      "version": 1,
      "status": "approved",
      "domainCode": "finance",
      "questionType": "short_reasoning",
      "prompt": "销售收入增长时，为什么不能直接判断利润也增长？",
      "referenceAnswer": "利润不仅取决于收入，还取决于商品成本、投放费用、履约及售后等费用；只有收入增长超过相关成本和费用增长时，利润才可能同步增长。",
      "rubric": {
        "version": 1,
        "criteria": [
          {
            "code": "distinguish_revenue_profit",
            "weight": 0.5,
            "concepts": ["收入不等于利润", "销售额不等于利润", "不能只看收入", "营收和利润不同"]
          },
          {
            "code": "account_for_costs_expenses",
            "weight": 0.5,
            "concepts": ["成本和费用", "商品成本", "投放成本", "履约费用", "售后费用", "费用增长"]
          }
