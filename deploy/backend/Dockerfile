FROM alpine:3.23

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY deploy/artifacts/backend/web-server /usr/local/bin/web-server
COPY backend/config/json /app/config/json
COPY backend/config/prompts /app/config/prompts
COPY deploy/backend/services.docker.toml /app/config/services.toml

RUN chmod +x /usr/local/bin/web-server

EXPOSE 19878

CMD ["web-server"]
